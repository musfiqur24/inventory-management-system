# Copy to .env.production on the server. Keep that file private.
# Server IPv4 address (private LAN/VPN addresses work): no http://, trailing slash, or port.
SERVER_IP=
# Generate a hexadecimal password with: openssl rand -hex 24
# Use hexadecimal/alphanumeric characters to avoid URL escaping in DATABASE_URL.
POSTGRES_PASSWORD=
# Separate application DB role password; generate another hex secret.
APP_DB_PASSWORD=
# Generate independently with: openssl rand -hex 32
JWT_SECRET=
INITIAL_SUPER_ADMIN_EMAIL=
# At least 12 characters; use a long random password.
# Single-quote passwords containing $ or # so Compose treats them literally.
INITIAL_SUPER_ADMIN_PASSWORD=
INITIAL_ORGANIZATION_NAME=FeedTrack Workspace

# Optional mail delivery. Without it password recovery is explicitly unavailable.
RESEND_API_KEY=
MAIL_FROM=Inventory System <noreply@example.com>

# Keep this stable across JWT rotations; protects authenticator secrets.
MFA_ENCRYPTION_KEY=
