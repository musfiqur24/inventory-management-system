# Copy to .env.production on the server. Keep that file private.
# Public server IPv4 address only: no http://, trailing slash, or port.
SERVER_IP=
# Generate a hexadecimal password with: openssl rand -hex 24
# Use hexadecimal/alphanumeric characters to avoid URL escaping in DATABASE_URL.
POSTGRES_PASSWORD=
# Generate independently with: openssl rand -hex 32
JWT_SECRET=
INITIAL_SUPER_ADMIN_EMAIL=
# At least 6 characters; use a long random password.
# Single-quote passwords containing $ or # so Compose treats them literally.
INITIAL_SUPER_ADMIN_PASSWORD=
INITIAL_ORGANIZATION_NAME=FeedTrack Workspace
